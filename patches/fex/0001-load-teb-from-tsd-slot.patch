diff --git a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
index 5ad6e7b..98575d1 100644
--- a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
+++ b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
@@ -107,6 +107,19 @@ constexpr ARMEmitter::PRegister PRED_TMP_32B = ARMEmitter::PReg::p7;
 // be used by both Arm64 JIT and ARM64 Dispatcher
 class Arm64Emitter : public ARMEmitter::Emitter {
 public:
+  // Load the TEB pointer into Reg.  On the Wine macOS ARM64 port x18 is zeroed by the
+  // kernel on every return to user mode, so the TEB is read from a fixed pthread TSD
+  // slot (key 700, see WINE_MACOS_TEB_TSD_KEY in Wine's winnt.h) via TPIDRRO_EL0.
+  void LoadTEB(ARMEmitter::XRegister Reg) {
+#ifdef WINE_MACOS_TSD_TEB
+    mrs(Reg.R(), ARMEmitter::SystemRegister::TPIDRRO_EL0);
+    and_(ARMEmitter::Size::i64Bit, Reg.R(), Reg.R(), ~7ULL);
+    ldr(Reg, Reg.R(), 8 * 700);
+#else
+    mov(Reg, ARMEmitter::XReg::x18);
+#endif
+  }
+
   Arm64Emitter(FEXCore::Context::ContextImpl* ctx, void* EmissionPtr = nullptr, size_t size = 0);
 
   enum class PadType {
